# Saar Visual Scientific Reasoning Engine - Environment Configuration Template
# Copy this file to .env and insert your API keys

# 1. Google AI Studio (Primary Multimodal VLM & 1M+ Context)
# Get key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Groq API (High-Speed LLaMA 3.3 ReAct Loop Reasoning)
# Get key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# 3. OpenRouter API (Multi-Model Resilient Fallback Catalog)
# Get key at: https://openrouter.ai/
OPENROUTER_API_KEY=

# 4. OpenAI API (Optional GPT-4o Vision)
OPENAI_API_KEY=
